<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.wuji</groupId>
        <artifactId>lowcode</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>lowcode_api</artifactId>

    <dependencies>
        <dependency>
            <artifactId>lowcode_system</artifactId>
            <groupId>com.wuji</groupId>
        </dependency>
        <dependency>
            <artifactId>lowcode_framework</artifactId>
            <exclusions>
                <exclusion>
                    <artifactId>log4j-core</artifactId>
                    <groupId>org.apache.logging.log4j</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>log4j-to-slf4j</artifactId>
                    <groupId>org.apache.logging.log4j</groupId>
                </exclusion>
                <exclusion>
                    <artifactId>log4j-api</artifactId>
                    <groupId>org.apache.logging.log4j</groupId>
                </exclusion>
            </exclusions>
            <groupId>com.wuji</groupId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <artifactId>lowcode_service</artifactId>
            <groupId>com.wuji</groupId>
        </dependency>
        <dependency>
            <artifactId>lowcode_wechat</artifactId>
            <groupId>com.wuji</groupId>
        </dependency>
        <dependency>
            <groupId>com.wuji</groupId>
            <artifactId>lowcode_open</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wuji</groupId>
            <artifactId>lowcode_message</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wuji</groupId>
            <artifactId>lowcode_systemapi</artifactId>
        </dependency>
        <dependency>
            <artifactId>lowcode_workflow</artifactId>
            <groupId>com.wuji</groupId>
            <exclusions>
                <exclusion>
                    <artifactId>mybatis</artifactId>
                    <groupId>org.mybatis</groupId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>dynamic-datasource-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wuji</groupId>
            <artifactId>lowcode_factory</artifactId>
        </dependency>
<!--        <dependency>-->
<!--            <groupId>com.github.core-lib</groupId>-->
<!--            <artifactId>xjar-core</artifactId>-->
<!--            <version>4.0.2</version>-->
<!--        </dependency>-->
    </dependencies>

    <build>
        <finalName>lowcode</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.core-lib</groupId>
                <artifactId>xjar-maven-plugin</artifactId>
                <version>4.0.2</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                        </goals>
                        <phase>package</phase>
                        <configuration>
                            <password>123456</password>
                            <includes>
                                <include>/**/*.class</include>
                                <include>/**/*.xml</include>
                                <include>/**/*.yml</include>
                            </includes>
                            <targetJar>${project.build.finalName}-xjar.jar</targetJar>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>